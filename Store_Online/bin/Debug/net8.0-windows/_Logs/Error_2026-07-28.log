SQL
--------------------------------------------------------------------------------

INSERT INTO SystemLogs
(
    LogDate,
    LogLevel,
    Title,
    Message,
    UserId,
    FullName,
    Email,
    BranchCode,
    SystemCode,
    ExceptionType,
    StackTrace,
    Source,
    MachineName,
    UserName,
    ApplicationName,
    SqlStatement,
    Parameters
)
VALUES
(
    GETDATE(),
    @LogLevel,
    @Title,
    @Message,
    @UserId,
    @FullName,
    @Email,
    @BranchCode,
    @SystemCode,
    @ExceptionType,
    @StackTrace,
    @Source,
    @MachineName,
    @UserName,
    @ApplicationName,
    @SqlStatement,
    @Parameters
)

