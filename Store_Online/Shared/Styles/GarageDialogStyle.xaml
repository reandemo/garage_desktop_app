<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Dialog Container -->
    <!-- ========================================================= -->

    <Style x:Key="GarageDialogContainer"
           TargetType="Border">

        <Setter Property="Background"
                Value="{StaticResource CardBackgroundBrush}" />

        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="CornerRadius"
                Value="12" />

        <Setter Property="Padding"
                Value="24" />

        <Setter Property="Margin"
                Value="10" />

    </Style>

    <!-- ========================================================= -->
    <!-- Dialog Title -->
    <!-- ========================================================= -->

    <Style x:Key="GarageDialogTitle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI" />

        <Setter Property="FontSize"
                Value="20" />

        <Setter Property="FontWeight"
                Value="Bold" />

        <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />

        <Setter Property="Margin"
                Value="0,0,0,10" />

    </Style>

    <!-- ========================================================= -->
    <!-- Dialog Message -->
    <!-- ========================================================= -->

    <Style x:Key="GarageDialogMessage"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="Segoe UI" />

        <Setter Property="FontSize"
                Value="13" />

        <Setter Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}" />

        <Setter Property="TextWrapping"
                Value="Wrap" />

    </Style>

    <!-- ========================================================= -->
    <!-- OK Button -->
    <!-- ========================================================= -->

    <Style x:Key="DialogPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButton}" />

    <!-- ========================================================= -->
    <!-- Cancel Button -->
    <!-- ========================================================= -->

    <Style x:Key="DialogCancelButton"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}" />

    <!-- ========================================================= -->
    <!-- Delete Button -->
    <!-- ========================================================= -->

    <Style x:Key="DialogDeleteButton"
           TargetType="Button"
           BasedOn="{StaticResource DangerButton}" />

    <!-- ========================================================= -->
    <!-- Save Button -->
    <!-- ========================================================= -->

    <Style x:Key="DialogSaveButton"
           TargetType="Button"
           BasedOn="{StaticResource SuccessButton}" />

</ResourceDictionary>