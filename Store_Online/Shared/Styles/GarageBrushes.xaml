<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Primary -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{StaticResource PrimaryColor}" />

    <SolidColorBrush x:Key="PrimaryDarkBrush"
                     Color="{StaticResource PrimaryDarkColor}" />

    <SolidColorBrush x:Key="PrimaryLightBrush"
                     Color="{StaticResource PrimaryLightColor}" />

    <!-- ========================================================= -->
    <!-- Accent -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentColor}" />

    <!-- ========================================================= -->
    <!-- Success -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="SuccessBrush"
                     Color="{StaticResource SuccessColor}" />

    <!-- ========================================================= -->
    <!-- Warning -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="WarningBrush"
                     Color="{StaticResource WarningColor}" />

    <!-- ========================================================= -->
    <!-- Danger -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="DangerBrush"
                     Color="{StaticResource DangerColor}" />

    <!-- ========================================================= -->
    <!-- Information -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="InfoBrush"
                     Color="{StaticResource InfoColor}" />

    <!-- ========================================================= -->
    <!-- Background -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="{StaticResource WindowBackgroundColor}" />

    <SolidColorBrush x:Key="PageBackgroundBrush"
                     Color="{StaticResource PageBackgroundColor}" />

    <SolidColorBrush x:Key="CardBackgroundBrush"
                     Color="{StaticResource CardBackgroundColor}" />

    <!-- ========================================================= -->
    <!-- Surface -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="{StaticResource SurfaceColor}" />

    <SolidColorBrush x:Key="SurfaceSecondaryBrush"
                     Color="{StaticResource SurfaceSecondaryColor}" />

    <!-- ========================================================= -->
    <!-- Border -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="BorderBrush"
                     Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="DividerBrush"
                     Color="{StaticResource DividerColor}" />

    <!-- ========================================================= -->
    <!-- Text -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="TextPrimaryBrush"
                     Color="{StaticResource TextPrimaryColor}" />

    <SolidColorBrush x:Key="TextSecondaryBrush"
                     Color="{StaticResource TextSecondaryColor}" />

    <SolidColorBrush x:Key="TextDisabledBrush"
                     Color="{StaticResource TextDisabledColor}" />

    <!-- ========================================================= -->
    <!-- Toolbar -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="ToolbarBackgroundBrush"
                     Color="{StaticResource ToolbarBackgroundColor}" />

    <SolidColorBrush x:Key="ToolbarHoverBrush"
                     Color="{StaticResource ToolbarHoverColor}" />

    <SolidColorBrush x:Key="ToolbarPressedBrush"
                     Color="{StaticResource ToolbarPressedColor}" />

    <!-- ========================================================= -->
    <!-- Menu -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="MenuBackgroundBrush"
                     Color="{StaticResource MenuBackgroundColor}" />

    <SolidColorBrush x:Key="MenuHoverBrush"
                     Color="{StaticResource MenuHoverColor}" />

    <!-- ========================================================= -->
    <!-- DataGrid -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="GridHeaderBrush"
                     Color="{StaticResource GridHeaderColor}" />

    <SolidColorBrush x:Key="GridRowHoverBrush"
                     Color="{StaticResource GridRowHoverColor}" />

    <SolidColorBrush x:Key="GridSelectedBrush"
                     Color="{StaticResource GridSelectedColor}" />

</ResourceDictionary>