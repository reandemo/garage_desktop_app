<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Colors  -->

    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryLight">#60A5FA</Color>

    <Color x:Key="SecondaryColor">#64748B</Color>

    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

    <Color x:Key="WindowBackground">#F8FAFC</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <Color x:Key="TextPrimary">#1E293B</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextHint">#94A3B8</Color>

    <Color x:Key="BorderColor">#E2E8F0</Color>

    <!--  Brushes  -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />

    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}" />

    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource WindowBackground}" />

    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBackground}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />

    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />

    <SolidColorBrush x:Key="HintBrush" Color="{StaticResource TextHint}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

</ResourceDictionary>
