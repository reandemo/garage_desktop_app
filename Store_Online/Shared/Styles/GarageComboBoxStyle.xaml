<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Base ComboBox -->
    <!-- ========================================================= -->

    <Style x:Key="GarageComboBoxBase"
           TargetType="ComboBox">

        <Setter Property="FontFamily"
                Value="Segoe UI"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Height"
                Value="40"/>

        <Setter Property="Padding"
                Value="10,4"/>

        <Setter Property="Background"
                Value="{StaticResource SurfaceBrush}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

        <Setter Property="SnapsToDevicePixels"
                Value="True"/>

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled"/>

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Default -->
    <!-- ========================================================= -->

    <Style x:Key="DefaultComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource GarageComboBoxBase}" />

    <!-- ========================================================= -->
    <!-- Toolbar -->
    <!-- ========================================================= -->

    <Style x:Key="ToolbarComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource GarageComboBoxBase}">

        <Setter Property="MinWidth"
                Value="150"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Filter -->
    <!-- ========================================================= -->

    <Style x:Key="FilterComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource GarageComboBoxBase}">

        <Setter Property="MinWidth"
                Value="180"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Small -->
    <!-- ========================================================= -->

    <Style x:Key="SmallComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource GarageComboBoxBase}">

        <Setter Property="Height"
                Value="34"/>

        <Setter Property="FontSize"
                Value="12"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Large -->
    <!-- ========================================================= -->

    <Style x:Key="LargeComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource GarageComboBoxBase}">

        <Setter Property="Height"
                Value="48"/>

        <Setter Property="FontSize"
                Value="15"/>

    </Style>

    <!-- ========================================================= -->
    <!-- ReadOnly (Disabled Appearance) -->
    <!-- ========================================================= -->

    <Style x:Key="ReadOnlyComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource GarageComboBoxBase}">

        <Setter Property="IsEnabled"
                Value="False"/>

        <Setter Property="Opacity"
                Value="0.75"/>

    </Style>

</ResourceDictionary>