<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Base Card -->
    <!-- ========================================================= -->

    <Style x:Key="GarageCard"
           TargetType="Border">

        <Setter Property="Background"
                Value="{StaticResource CardBackgroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="CornerRadius"
                Value="12"/>

        <Setter Property="Padding"
                Value="20"/>

        <Setter Property="Margin"
                Value="10"/>

        <Setter Property="SnapsToDevicePixels"
                Value="True"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Small Card -->
    <!-- ========================================================= -->

    <Style x:Key="SmallCard"
           TargetType="Border"
           BasedOn="{StaticResource GarageCard}">

        <Setter Property="Padding"
                Value="12"/>

        <Setter Property="Margin"
                Value="6"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Large Card -->
    <!-- ========================================================= -->

    <Style x:Key="LargeCard"
           TargetType="Border"
           BasedOn="{StaticResource GarageCard}">

        <Setter Property="Padding"
                Value="28"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Dashboard Card -->
    <!-- ========================================================= -->

    <Style x:Key="DashboardCard"
           TargetType="Border"
           BasedOn="{StaticResource GarageCard}">

        <Setter Property="Padding"
                Value="24"/>

        <Setter Property="Margin"
                Value="8"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Transparent Card -->
    <!-- ========================================================= -->

    <Style x:Key="TransparentCard"
           TargetType="Border"
           BasedOn="{StaticResource GarageCard}">

        <Setter Property="Background"
                Value="Transparent"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Elevated Card -->
    <!-- ========================================================= -->

    <Style x:Key="ElevatedCard"
           TargetType="Border"
           BasedOn="{StaticResource GarageCard}">

        <Setter Property="Effect">

            <Setter.Value>

                <DropShadowEffect
                    BlurRadius="16"
                    ShadowDepth="2"
                    Opacity="0.18"/>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>