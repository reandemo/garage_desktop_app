<UserControl x:Class="Store_Online.Shared.Controls.GarageToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="60"
             d:DesignWidth="1000">

    <Border Style="{StaticResource GarageCard}"
            Padding="16,12">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->

            <TextBox Grid.Column="0"
                     Height="38"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchTextBox}"
                     materialDesign:HintAssist.Hint="Search..." />

            <!-- Right Buttons -->

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Style="{StaticResource ToolbarGhostButton}"
                        Margin="0,0,8,0"
                        Command="{Binding NewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Plus"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Margin="6,0,0,0"
                                   Text="New"/>

                    </StackPanel>

                </Button>

                <Button Style="{StaticResource ToolbarGhostButton}"
                        Margin="0,0,8,0"
                        Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Pencil"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Margin="6,0,0,0"
                                   Text="Edit"/>

                    </StackPanel>

                </Button>

                <Button Style="{StaticResource ToolbarGhostButton}"
                        Margin="0,0,8,0"
                        Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Delete"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Margin="6,0,0,0"
                                   Text="Delete"/>

                    </StackPanel>

                </Button>

                <Button Style="{StaticResource ToolbarGhostButton}"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Margin="6,0,0,0"
                                   Text="Refresh"/>

                    </StackPanel>

                </Button>

                <Button Style="{StaticResource ToolbarGhostButton}"
                        Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="FileExport"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Margin="6,0,0,0"
                                   Text="Export"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>