<UserControl x:Class="Store_Online.Shared.Controls.GarageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="95"
             d:DesignWidth="900">

    <Border Style="{StaticResource GarageCard}"
            Padding="24,18">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <materialDesign:PackIcon
                Grid.Column="0"
                Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="34"
                Height="34"
                VerticalAlignment="Top"
                Foreground="{StaticResource PrimaryBrush}"/>

            <!-- Title + Subtitle -->
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource PageTitleText}"/>

                <TextBlock
                    Margin="0,4,0,0"
                    Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource SubtitleText}"
                    TextWrapping="Wrap"/>

            </StackPanel>

            <!-- Right -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">

                <Border
                    Background="{Binding StatusBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CornerRadius="12"
                    Padding="10,4">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="White"
                                 VerticalAlignment="Center"/>

                        <TextBlock
                            Margin="6,0,0,0"
                            Text="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource StatusText}"
                            Foreground="White"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>