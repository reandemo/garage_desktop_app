<UserControl x:Class="Store_Online.Shared.Controls.GarageQuickActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="700">

    <Border Style="{StaticResource GarageCard}"
            Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <DockPanel>

                <TextBlock
                    DockPanel.Dock="Left"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource SectionTitleText}"/>

                <TextBlock
                    DockPanel.Dock="Right"
                    Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource CaptionText}"/>

            </DockPanel>

            <!-- Tiles -->

            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <UniformGrid Columns="4"/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Button Command="{Binding Command}"
                                Margin="8"
                                Style="{StaticResource ToolbarGhostButton}">

                            <Border Padding="15"
                                    CornerRadius="10"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">

                                <StackPanel HorizontalAlignment="Center">

                                    <Border Width="56"
                                            Height="56"
                                            CornerRadius="28"
                                            Background="{Binding BackgroundBrush}"
                                            HorizontalAlignment="Center">

                                        <materialDesign:PackIcon
                                            Width="28"
                                            Height="28"
                                            Kind="{Binding Icon}"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"/>

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="{Binding Description}"/>

                                </StackPanel>

                            </Border>

                        </Button>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

    </Border>

</UserControl>