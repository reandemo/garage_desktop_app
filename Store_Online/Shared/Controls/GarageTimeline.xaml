<UserControl x:Class="Store_Online.Shared.Controls.GarageTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">

    <Border Style="{StaticResource GarageCard}"
            Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <DockPanel>

                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource SectionTitleText}"/>

                <TextBlock DockPanel.Dock="Right"
                           Style="{StaticResource CaptionText}"
                           Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            </DockPanel>

            <!-- Timeline -->

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Grid Margin="0,0,0,18">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <!-- Timeline -->

                                <Grid>

                                    <Border Width="2"
                                            Background="{StaticResource BorderBrush}"
                                            HorizontalAlignment="Center"/>

                                    <Ellipse Width="14"
                                             Height="14"
                                             Fill="{Binding IndicatorBrush}"
                                             Stroke="White"
                                             StrokeThickness="2"
                                             VerticalAlignment="Top"/>

                                </Grid>

                                <!-- Content -->

                                <Border Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="14"
                                        CornerRadius="8"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">

                                    <StackPanel>

                                        <DockPanel>

                                            <TextBlock DockPanel.Dock="Left"
                                                       FontWeight="Bold"
                                                       Text="{Binding Title}"/>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Style="{StaticResource CaptionText}"
                                                       Text="{Binding Time}"/>

                                        </DockPanel>

                                        <TextBlock Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource SubtitleText}"
                                                   Text="{Binding Description}"/>

                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource CaptionText}"
                                                   Text="{Binding User}"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>