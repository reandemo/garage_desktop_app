<UserControl x:Class="Store_Online.Shared.Controls.GarageFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="1000">

    <Border Style="{StaticResource GarageCard}"
            Padding="16">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->

            <TextBox Grid.Column="0"
                     Margin="0,0,12,0"
                     Style="{StaticResource SearchTextBox}"
                     materialDesign:HintAssist.Hint="Search..."
                     Text="{Binding SearchText,
                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />

            <!-- Category -->

            <ComboBox Grid.Column="1"
                      Margin="0,0,12,0"
                      Style="{StaticResource DefaultComboBox}"
                      ItemsSource="{Binding CategoryItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding SelectedCategory, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />

            <!-- Status -->

            <ComboBox Grid.Column="2"
                      Margin="0,0,12,0"
                      Style="{StaticResource DefaultComboBox}"
                      ItemsSource="{Binding StatusItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding SelectedStatus, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />

            <!-- Date -->

            <DatePicker Grid.Column="3"
                        Margin="0,0,12,0"
                        SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />

            <!-- Buttons -->

            <StackPanel Grid.Column="5"
                        Orientation="Horizontal">

                <Button Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding ResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Margin="6,0,0,0"
                                   Text="Reset"/>

                    </StackPanel>

                </Button>

                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="FilterCheck"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Margin="6,0,0,0"
                                   Text="Apply"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>