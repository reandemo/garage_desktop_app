<UserControl x:Class="Store_Online.Shared.Controls.GarageStatisticCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="140"
             d:DesignWidth="260">

    <Border Style="{StaticResource GarageCard}"
            Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource SubtitleText}"
                           FontWeight="SemiBold"/>

                <Border Grid.Column="1"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="{Binding IconBackground, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <materialDesign:PackIcon
                        Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Width="22"
                        Height="22"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

            </Grid>

            <!-- Value -->

            <TextBlock Grid.Row="1"
                       Margin="0,18,0,0"
                       Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <!-- Footer -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal">

                <materialDesign:PackIcon
                    Kind="TrendingUp"
                    Width="16"
                    Height="16"
                    Foreground="{Binding TrendBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <TextBlock Margin="6,0,0,0"
                           Text="{Binding Footer, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding TrendBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontWeight="SemiBold"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>