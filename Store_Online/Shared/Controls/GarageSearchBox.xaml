<UserControl x:Class="Store_Online.Shared.Controls.GarageSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="350">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- Search Icon -->

            <materialDesign:PackIcon
                Grid.Column="0"
                Width="18"
                Height="18"
                Kind="Magnify"
                Foreground="{StaticResource TextSecondaryBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <!-- Search Text -->

            <TextBox
                x:Name="PART_TextBox"
                Grid.Column="1"
                BorderThickness="0"
                Background="Transparent"
                VerticalContentAlignment="Center"
                FontSize="13"
                Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                materialDesign:HintAssist.Hint="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- Clear -->

            <Button
                Grid.Column="2"
                Width="28"
                Height="28"
                Margin="4"
                BorderThickness="0"
                Background="Transparent"
                Command="{Binding ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Kind="CloseCircleOutline"/>

            </Button>

        </Grid>

    </Border>

</UserControl>