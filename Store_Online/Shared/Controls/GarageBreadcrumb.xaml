<UserControl x:Class="Store_Online.Shared.Controls.GarageBreadcrumb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="800">

    <Border Style="{StaticResource GarageCard}"
            Padding="12,8">

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

            <!-- Home -->

            <materialDesign:PackIcon
                Kind="Home"
                Width="18"
                Height="18"
                Foreground="{StaticResource PrimaryBrush}"
                VerticalAlignment="Center"/>

            <TextBlock Margin="6,0"
                       VerticalAlignment="Center"
                       Text="{Binding HomeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource BodyText}"/>

            <!-- Separator -->

            <materialDesign:PackIcon
                Margin="10,0"
                Kind="ChevronRight"
                Width="16"
                Height="16"
                Foreground="{StaticResource TextSecondaryBrush}"
                VerticalAlignment="Center"/>

            <!-- Module -->

            <TextBlock VerticalAlignment="Center"
                       Text="{Binding ModuleText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource BodyText}"/>

            <!-- Separator -->

            <materialDesign:PackIcon
                Margin="10,0"
                Kind="ChevronRight"
                Width="16"
                Height="16"
                Foreground="{StaticResource TextSecondaryBrush}"
                VerticalAlignment="Center"/>

            <!-- Page -->

            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Text="{Binding PageText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        </StackPanel>

    </Border>

</UserControl>