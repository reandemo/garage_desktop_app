<UserControl x:Class="Store_Online.Shared.Controls.GarageSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="260">

    <Border Style="{StaticResource GarageCard}"
            Padding="18">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource CaptionText}"/>

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource SubtitleText}"
                    Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Width="52"
                    Height="52"
                    CornerRadius="26"
                    Background="{Binding IconBackground, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <materialDesign:PackIcon
                    Width="26"
                    Height="26"
                    Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

        </Grid>

    </Border>

</UserControl>