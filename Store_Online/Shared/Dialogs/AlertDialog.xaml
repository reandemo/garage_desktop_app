<UserControl
    x:Class="Store_Online.Shared.Dialogs.AlertDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="430"
    MinHeight="340"
    mc:Ignorable="d">

    <UserControl.Resources>

        <DropShadowEffect
            x:Key="DialogShadow"
            BlurRadius="35"
            Opacity="0.20"
            ShadowDepth="2"
            Color="Black" />

        <Style x:Key="ModernButton" TargetType="Button">

            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B56A72" />
            <Setter Property="BorderBrush" Value="#B56A72" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#A45D64" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#8E4C53" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Margin="20" Background="Transparent">

        <Border
            Width="390"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="18"
            Effect="{StaticResource DialogShadow}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Success Icon  -->

                <Border
                    Grid.Row="0"
                    Width="84"
                    Height="84"
                    HorizontalAlignment="Center"
                    Background="#E8F5E9"
                    BorderBrush="#A5D6A7"
                    BorderThickness="2"
                    CornerRadius="42">

                    <materialDesign:PackIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#188038"
                        Kind="Check" />

                </Border>

                <!--  Title  -->

                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#188038"
                    Text="Success" />

                <!--  Message  -->

                <TextBlock
                    x:Name="MessageText"
                    Grid.Row="4"
                    Width="280"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="#444444"
                    Text="Customer saved successfully."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--  OK Button  -->

                <Button
                    x:Name="BtnOK"
                    Grid.Row="6"
                    HorizontalAlignment="Center"
                    Click="BtnOK_Click"
                    Content="OK"
                    Style="{StaticResource ModernButton}" />

            </Grid>

        </Border>

    </Grid>

</UserControl>
