<UserControl
    x:Class="Store_Online.Shared.Dialogs.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="430"
    MinHeight="390"
    mc:Ignorable="d">

    <UserControl.Resources>

        <DropShadowEffect
            x:Key="DialogShadow"
            BlurRadius="35"
            Opacity="0.20"
            ShadowDepth="2"
            Color="Black" />

        <!--  Primary Button  -->

        <Style x:Key="PrimaryButton" TargetType="Button">

            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B56A72" />
            <Setter Property="BorderBrush" Value="#B56A72" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#A45D64" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#8E4C53" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--  Secondary Button  -->

        <Style
            x:Key="SecondaryButton"
            BasedOn="{StaticResource PrimaryButton}"
            TargetType="Button">

            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#E8E8E8" />
            <Setter Property="Foreground" Value="#444444" />

        </Style>

    </UserControl.Resources>

    <Grid Margin="20" Background="Transparent">

        <Border
            Width="390"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="18"
            Effect="{StaticResource DialogShadow}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Lock Icon  -->

                <Border
                    Grid.Row="0"
                    Width="84"
                    Height="84"
                    HorizontalAlignment="Center"
                    Background="#F3E8FF"
                    BorderBrush="#C8A8F2"
                    BorderThickness="2"
                    CornerRadius="42">

                    <materialDesign:PackIcon
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#7E57C2"
                        Kind="Lock" />

                </Border>

                <!--  Title  -->

                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#7E57C2"
                    Text="Password" />

                <!--  Message  -->

                <TextBlock
                    x:Name="MessageText"
                    Grid.Row="4"
                    Width="290"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="#444444"
                    Text="Please enter your password."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--  Password  -->

                <PasswordBox
                    x:Name="PasswordBox"
                    Grid.Row="6"
                    Height="42"
                    Margin="20,0"
                    Padding="12,6"
                    VerticalContentAlignment="Center"
                    materialDesign:HintAssist.Hint="Enter password"
                    FontSize="15" />

                <!--  Buttons  -->

                <StackPanel
                    Grid.Row="8"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        x:Name="BtnCancel"
                        Margin="0,0,15,0"
                        Click="BtnCancel_Click"
                        Style="{StaticResource SecondaryButton}">
                        Cancel
                    </Button>

                    <Button
                        x:Name="BtnOK"
                        Click="BtnOK_Click"
                        Style="{StaticResource PrimaryButton}">
                        OK
                    </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>
