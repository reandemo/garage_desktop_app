<UserControl
    x:Class="Store_Online.Shared.Dialogs.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="430"
    MinHeight="390"
    mc:Ignorable="d">

    <UserControl.Resources>

        <DropShadowEffect
            x:Key="DialogShadow"
            BlurRadius="35"
            Opacity="0.20"
            ShadowDepth="2"
            Color="Black" />

        <!--  Primary Button  -->

        <Style x:Key="PrimaryButton" TargetType="Button">

            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B56A72" />
            <Setter Property="BorderBrush" Value="#B56A72" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#A45D64" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#8E4C53" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Margin="20" Background="Transparent">

        <Border
            Width="390"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="18"
            Effect="{StaticResource DialogShadow}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Progress Icon  -->

                <Border
                    Grid.Row="0"
                    Width="84"
                    Height="84"
                    HorizontalAlignment="Center"
                    Background="#EAF4FF"
                    BorderBrush="#9FC9FF"
                    BorderThickness="2"
                    CornerRadius="42">

                    <materialDesign:PackIcon
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#2196F3"
                        Kind="ProgressClock" />

                </Border>

                <!--  Title  -->

                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#2196F3"
                    Text="Processing" />

                <!--  Message  -->

                <TextBlock
                    x:Name="MessageText"
                    Grid.Row="4"
                    Width="300"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="#444444"
                    Text="Please wait while the operation is being completed."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--  Progress Bar  -->

                <ProgressBar
                    x:Name="ProgressBar"
                    Grid.Row="6"
                    Height="10"
                    Margin="20,0"
                    IsIndeterminate="False"
                    Maximum="100"
                    Minimum="0"
                    Value="0" />

                <!--  Percent  -->

                <TextBlock
                    x:Name="PercentText"
                    Grid.Row="8"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#2196F3"
                    Text="0%" />

                <!--  Cancel Button  -->

                <Button
                    x:Name="BtnCancel"
                    Grid.Row="10"
                    HorizontalAlignment="Center"
                    Click="BtnCancel_Click"
                    Style="{StaticResource PrimaryButton}">
                    Cancel
                </Button>

            </Grid>

        </Border>

    </Grid>

</UserControl>
