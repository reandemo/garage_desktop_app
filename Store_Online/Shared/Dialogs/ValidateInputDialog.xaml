<UserControl
    x:Class="Store_Online.Shared.Dialogs.ValidateInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="430"
    MinHeight="360"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Soft Shadow  -->

        <DropShadowEffect
            x:Key="DialogShadow"
            BlurRadius="35"
            Opacity="0.20"
            ShadowDepth="2"
            Color="Black" />

        <!--  Modern Button  -->

        <Style x:Key="PrimaryButton" TargetType="Button">

            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B56A72" />
            <Setter Property="BorderBrush" Value="#B56A72" />
            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#A45D64" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#8F4D55" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Margin="20" Background="Transparent">

        <Border
            Width="390"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="18"
            Effect="{StaticResource DialogShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <!--  Validation Icon  -->

                <Border
                    Grid.Row="0"
                    Width="84"
                    Height="84"
                    HorizontalAlignment="Center"
                    Background="#FFF8E9"
                    BorderBrush="#F4C56B"
                    BorderThickness="2"
                    CornerRadius="42">

                    <materialDesign:PackIcon
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#F39C12"
                        Kind="AlertCircleOutline" />

                </Border>

                <!--  Title  -->

                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#F39C12"
                    Text="Validate Input" />

                <!--  Divider  -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <Border
                        Height="1"
                        VerticalAlignment="Center"
                        Background="#EEEEEE" />

                    <Ellipse
                        Grid.Column="1"
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="#F39C12" />

                    <Border
                        Grid.Column="2"
                        Height="1"
                        VerticalAlignment="Center"
                        Background="#EEEEEE" />

                </Grid>

                <!--  Message  -->

                <StackPanel Grid.Row="6" Margin="10,0">

                    <TextBlock
                        x:Name="MessageText"
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#333333"
                        Text="Customer Name is required."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="DescriptionText"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Foreground="#666666"
                        Text="Please enter a valid value and try again."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                </StackPanel>

                <!--  OK Button  -->

                <Button
                    x:Name="BtnOK"
                    Grid.Row="8"
                    HorizontalAlignment="Center"
                    Click="BtnOK_Click"
                    Style="{StaticResource PrimaryButton}">
                    OK
                </Button>

            </Grid>

        </Border>

    </Grid>

</UserControl>