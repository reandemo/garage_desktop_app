<UserControl
    x:Class="Store_Online.Shared.Dialogs.LoadingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="430"
    MinHeight="320"
    mc:Ignorable="d">

    <UserControl.Resources>

        <DropShadowEffect
            x:Key="DialogShadow"
            BlurRadius="35"
            Opacity="0.20"
            ShadowDepth="2"
            Color="Black" />

    </UserControl.Resources>

    <Grid Margin="20" Background="Transparent">

        <Border
            Width="390"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="18"
            Effect="{StaticResource DialogShadow}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Loading Icon  -->

                <Border
                    Grid.Row="0"
                    Width="84"
                    Height="84"
                    HorizontalAlignment="Center"
                    Background="#EAF4FF"
                    BorderBrush="#A5CFFF"
                    BorderThickness="2"
                    CornerRadius="42">

                    <materialDesign:PackIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#2196F3"
                        Kind="Loading">

                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform />
                        </materialDesign:PackIcon.RenderTransform>

                        <materialDesign:PackIcon.Triggers>

                            <EventTrigger RoutedEvent="Loaded">

                                <BeginStoryboard>

                                    <Storyboard RepeatBehavior="Forever">

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.Angle"
                                            From="0"
                                            To="360"
                                            Duration="0:0:1" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                        </materialDesign:PackIcon.Triggers>

                    </materialDesign:PackIcon>

                </Border>

                <!--  Title  -->

                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#2196F3"
                    Text="Loading" />

                <!--  Message  -->

                <TextBlock
                    x:Name="MessageText"
                    Grid.Row="4"
                    Width="290"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="#555555"
                    Text="Please wait while processing..."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

            </Grid>

        </Border>

    </Grid>

</UserControl>
