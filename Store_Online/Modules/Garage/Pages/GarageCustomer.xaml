<Page x:Class="Store_Online.Modules.Garage.Pages.GarageCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Store_Online.Shared.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:Store_Online.Modules.Garage.Pages"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1200"
      Title="GarageCustomer">

    <Grid Background="#F5F7FA" Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0"
        Background="White"
        CornerRadius="8"
        Padding="18"
        BorderBrush="#DDDDDD"
        BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Width="48"
                Height="48"
                Background="#E3F2FD"
                CornerRadius="24"
                VerticalAlignment="Top">

                    <materialDesign:PackIcon Kind="AccountPlus"
                                     Width="26"
                                     Height="26"
                                     Foreground="#1976D2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1"
                    Margin="15,0,0,0">

                    <TextBlock Text="New Customer Registration"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#2F3944"/>

                    <TextBlock Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="Gray"
                       Text="Create a new customer profile for vehicle service and maintenance."/>

                </StackPanel>

                <!-- Status -->
                <Border Grid.Column="2"
                Background="#E8F5E9"
                BorderBrush="#4CAF50"
                BorderThickness="1"
                CornerRadius="15"
                Padding="12,5"
                VerticalAlignment="Top">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                         Height="8"
                         Fill="#4CAF50"
                         VerticalAlignment="Center"/>

                        <TextBlock Margin="8,0,0,0"
                           Text="Ready to Create"
                           FontWeight="SemiBold"
                           Foreground="#2E7D32"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2"
        Background="White"
        CornerRadius="8"
        Padding="15"
        BorderBrush="#DDDDDD"
        BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox x:Name="txtSearch"
                 Grid.Column="0"
                 Height="40"
                 VerticalContentAlignment="Center"
                 materialDesign:HintAssist.Hint="Search customer..."
                 materialDesign:TextFieldAssist.HasClearButton="True"
                 materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                 ToolTip="Search by customer code, name, phone or email"/>

                <!-- Status -->
                <ComboBox x:Name="cboFilterStatus"
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  Height="40"
                  SelectedIndex="0"
                  materialDesign:HintAssist.Hint="Status">

                    <ComboBoxItem Content="All Status"/>
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="Inactive"/>

                </ComboBox>

                <!-- Province -->
                <ComboBox x:Name="cboFilterProvince"
                  Grid.Column="2"
                  Margin="10,0,0,0"
                  Height="40"
                  materialDesign:HintAssist.Hint="Province">

                    <ComboBoxItem Content="All Provinces"/>

                </ComboBox>

                <!-- New Customer -->
                <Button x:Name="btnNewCustomer"
                Grid.Column="4"
                Margin="10,0,0,0"
                Height="40"
                Background="#2E7D32"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Create New Customer"
                Click="btnNewCustomer_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="AccountPlus"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,8,0"/>

                        <TextBlock Text="New Customer"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                    </StackPanel>

                </Button>

                <!-- Refresh -->
                <Button x:Name="btnRefresh"
                Grid.Column="5"
                Margin="10,0,0,0"
                Height="40"
                Cursor="Hand"
                ToolTip="Refresh Customer List"
                Click="btnRefresh_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Refresh"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,6,0"/>

                        <TextBlock Text="Refresh"
                           VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!-- Export -->
                <Button x:Name="btnExport"
                Grid.Column="6"
                Margin="10,0,0,0"
                Height="40"
                Cursor="Hand"
                ToolTip="Export to Excel"
                Click="btnExport_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="MicrosoftExcel"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,6,0"/>

                        <TextBlock Text="Export"
                           VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

        <!-- Customer List -->
        <Border Grid.Row="4"
        Margin="0,8,0,0"
        Background="White"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="8">

            <DataGrid x:Name="dgCustomer"
              Style="{StaticResource GarageDataGrid}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="#"
                                Width="55"
                                Binding="{Binding No}" />

                    <DataGridTextColumn Header="Code"
                                Width="110"
                                Binding="{Binding CustomerCode}" />

                    <DataGridTextColumn Header="Customer Name"
                                Width="220"
                                Binding="{Binding CustomerName}" />

                    <DataGridTextColumn Header="Gender"
                                Width="80"
                                Binding="{Binding Gender}" />

                    <DataGridTextColumn Header="Phone"
                                Width="135"
                                Binding="{Binding Phone}" />

                    <DataGridTextColumn Header="Email"
                                Width="220"
                                Binding="{Binding Email}" />

                    <DataGridTextColumn Header="Province"
                                Width="140"
                                Binding="{Binding Province}" />

                    <DataGridTextColumn Header="Vehicles"
                                Width="80"
                                Binding="{Binding VehicleCount}" />

                    <DataGridTemplateColumn Header="Status"
                                    Width="95">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Padding="8,2"
                                CornerRadius="10"
                                Background="{Binding StatusColor}"
                                HorizontalAlignment="Center">

                                    <TextBlock Text="{Binding Status}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" />

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header=""
                                    Width="105"
                                    IsReadOnly="True">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                                    <Button Width="24"
                                    Height="24"
                                    Margin="2"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="View">

                                        <materialDesign:PackIcon Kind="EyeOutline"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="#6B7280" />

                                    </Button>

                                    <Button Width="24"
                                    Height="24"
                                    Margin="2"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Edit">

                                        <materialDesign:PackIcon Kind="PencilOutline"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="{StaticResource AccentBrush}" />

                                    </Button>

                                    <Button Width="24"
                                    Height="24"
                                    Margin="2"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Delete">

                                        <materialDesign:PackIcon Kind="TrashCanOutline"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="#D9534F" />

                                    </Button>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>
        <!-- Footer -->
        <controls:GaragePagination
    x:Name="pagination"
    Grid.Row="5"
    Margin="0,2,0,0"/>
    </Grid>

</Page>