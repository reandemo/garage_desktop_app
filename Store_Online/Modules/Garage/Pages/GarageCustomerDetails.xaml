<Page x:Class="Store_Online.Modules.Garage.Pages.GarageCustomerDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="GarageCustomerDetails"
      d:DesignHeight="850"
      d:DesignWidth="1400">

    <Grid Background="#F5F7FA" Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="20"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Left">

                    <TextBlock Text="Customer Details"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#2F3944"/>

                    <TextBlock Text="Customer profile, vehicles and service information."
                               FontSize="13"
                               Foreground="Gray"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <Button Width="120"
                            Height="38"
                            Margin="5">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil"/>
                            <TextBlock Margin="8,0,0,0"
                                       Text="Edit"/>
                        </StackPanel>

                    </Button>

                    <Button Width="120"
                            Height="38"
                            Margin="5">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer"/>
                            <TextBlock Margin="8,0,0,0"
                                       Text="Print"/>
                        </StackPanel>

                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Customer Information -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="20"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Customer Code"
                           FontWeight="Bold"/>
                <TextBlock Grid.Column="1"
                           Text="CUS000001"/>

                <TextBlock Grid.Row="1"
                           Text="Customer Name"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="John Smith"/>

                <TextBlock Grid.Row="2"
                           Text="Gender"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="Male"/>

                <TextBlock Grid.Row="3"
                           Text="Date of Birth"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="15-Jan-1990"/>

                <TextBlock Grid.Row="4"
                           Text="Phone"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="+855 12 345 678"/>

                <TextBlock Grid.Column="3"
                           Text="Province"
                           FontWeight="Bold"/>
                <TextBlock Grid.Column="4"
                           Text="Phnom Penh"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Text="City"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="4"
                           Text="Sen Sok"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="3"
                           Text="Status"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="4"
                           Text="Active"
                           Foreground="Green"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="3"
                           Text="Address"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="3"
                           Grid.Column="4"
                           Grid.RowSpan="2"
                           Text="Street 2004, Phnom Penh"
                           TextWrapping="Wrap"/>

            </Grid>

        </Border>

        <!-- Summary -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Vehicle -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="20">

                <StackPanel>

                    <materialDesign:PackIcon Kind="Car"
                                             Width="40"
                                             Height="40"
                                             Foreground="#1976D2"/>

                    <TextBlock Text="Vehicle Summary"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,10,0,15"/>

                    <TextBlock Text="Total Vehicles : 3"
                               FontSize="14"/>

                    <TextBlock Text="Active : 3"
                               FontSize="14"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="In Service : 1"
                               FontSize="14"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

            <!-- Service -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="20">

                <StackPanel>

                    <materialDesign:PackIcon Kind="Wrench"
                                             Width="40"
                                             Height="40"
                                             Foreground="#43A047"/>

                    <TextBlock Text="Service Summary"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,10,0,15"/>

                    <TextBlock Text="Total Services : 15"/>

                    <TextBlock Text="Completed : 13"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Pending : 2"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

            <!-- Invoice -->
            <Border Grid.Column="4"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="20">

                <StackPanel>

                    <materialDesign:PackIcon Kind="Receipt"
                                             Width="40"
                                             Height="40"
                                             Foreground="#FB8C00"/>

                    <TextBlock Text="Invoice Summary"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,10,0,15"/>

                    <TextBlock Text="Invoices : 12"/>

                    <TextBlock Text="Paid : 10"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Outstanding : 2"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Vehicle List -->
        <Border Grid.Row="6"
                Background="White"
                CornerRadius="8"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Padding="10">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="5"
                           Text="Vehicle List"/>

                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Margin="0,10,0,0">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Plate No"
                                            Binding="{Binding PlateNo}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Brand"
                                            Binding="{Binding Brand}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Model"
                                            Binding="{Binding Model}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Year"
                                            Binding="{Binding Year}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Color"
                                            Binding="{Binding Color}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </Border>

        <!-- Service History -->
        <Border Grid.Row="8"
                Background="White"
                CornerRadius="8"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Padding="10">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="5"
                           Text="Recent Service History"/>

                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Margin="0,10,0,0">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Invoice No"
                                            Binding="{Binding InvoiceNo}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding Date}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Technician"
                                            Binding="{Binding Technician}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </Border>

        <!-- Bottom Buttons -->
        <Border Grid.Row="10"
                Background="White"
                CornerRadius="8"
                Padding="15"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Width="130"
                        Height="40"
                        Margin="5"
                        Content="Edit Customer"/>

                <Button Width="100"
                        Height="40"
                        Margin="5"
                        Content="Print"/>

                <Button Width="100"
                        Height="40"
                        Margin="5"
                        Content="Refresh"/>

                <Button Width="100"
                        Height="40"
                        Margin="5"
                        Content="Close"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>