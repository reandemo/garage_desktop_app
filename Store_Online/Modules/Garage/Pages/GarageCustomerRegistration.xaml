<Page
    x:Class="Store_Online.Modules.Garage.Pages.GarageCustomerRegistration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Store_Online.Shared.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Store_Online.Modules.Garage.Pages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GarageCustomerRegistration"
    d:DesignHeight="750"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid Margin="15" Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Customer Information  -->
        <Border
            Grid.Row="0"
            Padding="25"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel>

                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#2F3944"
                    Text="Customer Information" />

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="55" />
                        <RowDefinition Height="55" />
                        <RowDefinition Height="55" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>

                    <!--  Customer Code  -->
                    <TextBlock
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Customer Code" />

                    <TextBox
                        x:Name="txtCustomerCode"
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="40"
                        materialDesign:HintAssist.Hint="Auto Generated"
                        Background="#F3F3F3"
                        IsReadOnly="True"
                        IsTabStop="False" />

                    <!--  Phone  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Phone" />

                    <TextBox
                        x:Name="txtPhone"
                        Grid.Row="0"
                        Grid.Column="4"
                        Height="40"
                        materialDesign:HintAssist.Hint="Phone Number" />

                    <!--  Customer Name  -->
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Customer Name *" />

                    <TextBox
                        x:Name="txtCustomerName"
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="40"
                        materialDesign:HintAssist.Hint="Customer Name" />

                    <!--  Email  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Email" />

                    <TextBox
                        x:Name="txtEmail"
                        Grid.Row="1"
                        Grid.Column="4"
                        Height="40"
                        materialDesign:HintAssist.Hint="Email Address" />

                    <!--  Gender  -->
                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Gender" />

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <RadioButton
                            x:Name="rdoMale"
                            Margin="0,0,25,0"
                            Content="Male"
                            IsChecked="True" />

                        <RadioButton x:Name="rdoFemale" Content="Female" />

                    </StackPanel>

                    <!--  Province  -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Province" />

                    <ComboBox
                        x:Name="cboProvince"
                        Grid.Row="2"
                        Grid.Column="4"
                        Height="40"
                        materialDesign:HintAssist.Hint="Select Province" />

                    <!--  Date of Birth  -->
                    <TextBlock
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Date of Birth" />

                    <DatePicker
                        x:Name="dtpDateOfBirth"
                        Grid.Row="3"
                        Grid.Column="1"
                        Height="40"
                        SelectedDate="{x:Null}"
                        SelectedDateFormat="Short" />

                    <!--  Status  -->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Status" />

                    <ComboBox
                        x:Name="cboStatus"
                        Grid.Row="3"
                        Grid.Column="4"
                        Height="40"
                        SelectedIndex="0">

                        <ComboBoxItem Content="Active" />
                        <ComboBoxItem Content="Inactive" />

                    </ComboBox>

                    <!--  Remark  -->
                    <TextBlock
                        Grid.Row="4"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        FontWeight="SemiBold"
                        Text="Remark" />

                    <TextBox
                        x:Name="txtRemark"
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="4"
                        Height="90"
                        Margin="0,5,0,0"
                        materialDesign:HintAssist.Hint="Additional Remark"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                </Grid>

            </StackPanel>

        </Border>

        <!--  Action Buttons  -->
        <Border
            Grid.Row="2"
            Padding="15"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="8">

            <DockPanel LastChildFill="False">

                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#666"
                    Text="Fields marked with * are required." />

                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">

                    <Button
                        x:Name="btnSave"
                        Width="120"
                        Height="42"
                        Margin="5"
                        Background="#2E7D32"
                        BorderThickness="0"
                        Click="btnSave_Click"
                        Foreground="White">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Kind="ContentSave" />

                            <TextBlock VerticalAlignment="Center" Text="Save" />

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="btnUpdate"
                        Width="120"
                        Height="42"
                        Margin="5"
                        Background="#1976D2"
                        BorderThickness="0"
                        Click="btnUpdate_Click"
                        Foreground="White"
                        IsEnabled="False">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Kind="Pencil" />

                            <TextBlock VerticalAlignment="Center" Text="Update" />

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="btnClear"
                        Width="120"
                        Height="42"
                        Margin="5"
                        Click="btnClear_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Kind="Broom" />

                            <TextBlock VerticalAlignment="Center" Text="Clear" />

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="btnClose"
                        Width="120"
                        Height="42"
                        Margin="5"
                        Background="#D32F2F"
                        BorderThickness="0"
                        Click="btnClose_Click"
                        Foreground="White">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Kind="CloseCircle" />

                            <TextBlock VerticalAlignment="Center" Text="Close" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>
</Page>
