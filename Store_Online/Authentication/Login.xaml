<Window
    x:Class="Store_Online.Authentication.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Store_Online.Shared.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notifications="clr-namespace:Store_Online.Shared.Notifications"
    Width="500"
    Height="600"
    AllowsTransparency="True"
    Background="{x:Null}"
    FontFamily="{DynamicResource AppFont}"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    ResizeMode="NoResize"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <materialDesign:Card
            Width="430"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp4"
            UniformCornerRadius="15">

            <materialDesign:DialogHost x:Name="DialogHost" CloseOnClickAway="True">

                <Grid Margin="8">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Logo  -->

                    <controls:AppLogoControl
                        Title="{Binding [APP_NAME], Source={StaticResource Lang}}"
                        Grid.Row="0"
                        Margin="0,10,0,20"
                        HorizontalAlignment="Center"
                        LogoSize="77"
                        LogoSource="/Shared/Assets/Images/money.png"
                        Subtitle="Powered by REAN-PRO" />

                    <!--  Notification  -->

                    <notifications:NotificationControl
                        x:Name="Notifier"
                        Grid.Row="1"
                        Width="333"
                        HorizontalAlignment="Center" />

                    <!--  Login Form  -->

                    <Border
                        Grid.Row="2"
                        Width="333"
                        HorizontalAlignment="Center"
                        Background="Transparent">

                        <StackPanel>

                            <TextBox
                                x:Name="txtUserlogin"
                                Width="333"
                                Height="66"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:HintAssist.Foreground="{StaticResource HintBrush}"
                                materialDesign:HintAssist.Hint="{Binding [LBL_USERNAME], Source={StaticResource Lang}}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Account"
                                Background="Transparent"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="2"
                                CaretBrush="{DynamicResource MaterialDesignBody}"
                                FontFamily="{DynamicResource HandFont}"
                                FontSize="18"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                HorizontalScrollBarVisibility="Hidden"
                                SelectionBrush="{DynamicResource PrimaryHueMidBrush}"
                                SpellCheck.IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Disabled" />
                            <Grid
                                Width="333"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center">

                                <!--  Hidden Password  -->
                                <PasswordBox
                                    x:Name="txtPassword"
                                    Width="333"
                                    Height="66"
                                    VerticalContentAlignment="Center"
                                    materialDesign:HintAssist.Foreground="{StaticResource HintBrush}"
                                    materialDesign:HintAssist.Hint="{Binding [LBL_PASSWORD], Source={StaticResource Lang}}"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="2"
                                    CaretBrush="{DynamicResource MaterialDesignBody}"
                                    FontFamily="{DynamicResource HandFont}"
                                    FontSize="18"
                                    Foreground="{DynamicResource MaterialDesignBody}"
                                    KeyDown="txtPassword_KeyDown"
                                    PasswordChanged="txtPassword_PasswordChanged"
                                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                                <!--  Visible Password  -->
                                <TextBox
                                    x:Name="txtPasswordVisible"
                                    Width="333"
                                    Height="66"
                                    VerticalContentAlignment="Center"
                                    materialDesign:HintAssist.Foreground="{StaticResource HintBrush}"
                                    materialDesign:HintAssist.Hint="{Binding [LBL_PASSWORD], Source={StaticResource Lang}}"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="LockOpen"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="2"
                                    CaretBrush="{DynamicResource MaterialDesignBody}"
                                    FontFamily="{DynamicResource HandFont}"
                                    FontSize="18"
                                    Foreground="{DynamicResource MaterialDesignBody}"
                                    KeyDown="txtPassword_KeyDown"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    TextChanged="txtPasswordVisible_TextChanged"
                                    Visibility="Collapsed" />

                                <!--  Clickable Icon  -->
                                <Rectangle
                                    Width="40"
                                    Height="40"
                                    Margin="16,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Fill="Transparent"
                                    MouseLeftButtonDown="PasswordIcon_MouseLeftButtonDown" />

                            </Grid>
                        </StackPanel>

                    </Border>

                    <!--  Login & Footer  -->

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center">

                        <Button
                            x:Name="btnLogin"
                            Width="333"
                            Height="50"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            materialDesign:ElevationAssist.Elevation="Dp4"
                            Background="#2563EB"
                            BorderThickness="0"
                            Click="Btn_login_Click"
                            Cursor="Hand"
                            FontFamily="{DynamicResource HandFont}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="White">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="LoginVariant" />

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    FontFamily="{DynamicResource HandFont}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding [BTN_LOGIN], Source={StaticResource Lang}}" />

                            </Grid>

                        </Button>

                        <!--  Footer Actions  -->

                        <Grid Width="333" Margin="0,16,0,0">

                            <Grid.Resources>

                                <Style x:Key="FooterTextStyle" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#374151" />
                                    <Setter Property="FontFamily" Value="{DynamicResource HandFont}" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="FooterIconStyle" TargetType="materialDesign:PackIcon">
                                    <Setter Property="Foreground" Value="#6B7280" />
                                    <Setter Property="Width" Value="17" />
                                    <Setter Property="Height" Value="17" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </Grid.Resources>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="Btn_SetupStore"
                                Grid.Column="0"
                                Padding="4,6"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="Btn_setupstore_Click"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="StorePlusOutline" Style="{StaticResource FooterIconStyle}" />

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FooterTextStyle}"
                                        Text="Create Store" />

                                </StackPanel>

                            </Button>

                            <Button
                                x:Name="Btn_Exit"
                                Grid.Column="1"
                                Padding="4,6"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="Btn_Exit_Click"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="Logout" Style="{StaticResource FooterIconStyle}" />

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FooterTextStyle}"
                                        Text="Exit" />

                                </StackPanel>

                            </Button>

                        </Grid>

                    </StackPanel>

                </Grid>

            </materialDesign:DialogHost>

        </materialDesign:Card>

    </Grid>

</Window>
