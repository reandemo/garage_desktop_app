<Window
    x:Class="Store_Online.Authentication.StoreSetup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="555"
    Height="800"
    AllowsTransparency="True"
    Background="{x:Null}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <materialDesign:Card
        Width="444"
        Padding="10"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        materialDesign:ElevationAssist.Elevation="Dp4"
        UniformCornerRadius="15">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->

            <Grid>

                <Button
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnClose_Click"
                    Cursor="Hand">

                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Foreground="#6B7280"
                        Kind="Close" />

                </Button>

                <StackPanel Margin="0,8,0,20">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource HandFont}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Create New Store" />

                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Foreground="#757575"
                        Text="Setup your business with REAN-PRO" />

                </StackPanel>

            </Grid>

            <!--  Content  -->

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">

                <ComboBox
                    x:Name="cbSystemType"
                    Width="333"
                    Margin="0,0,0,10"
                    materialDesign:HintAssist.Hint="System Type">

                    <ComboBoxItem Content="Store Management" />
                    <ComboBoxItem Content="Garage Management" />
                    <ComboBoxItem Content="Restaurant Management" />
                    <ComboBoxItem Content="POS System" />
                    <ComboBoxItem Content="Pharmacy Management" />

                </ComboBox>

                <TextBox
                    x:Name="txtStoreName"
                    Width="333"
                    Margin="0,0,0,10"
                    materialDesign:HintAssist.Hint="Store Name"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Store"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <TextBox
                    x:Name="txtPhone"
                    Width="333"
                    Margin="0,0,0,10"
                    materialDesign:HintAssist.Hint="Phone Number"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Phone"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <ComboBox
                    x:Name="cbLocation"
                    Width="333"
                    Margin="0,0,0,10"
                    materialDesign:HintAssist.Hint="Location">

                    <ComboBoxItem Content="PP - Phnom Penh" />
                    <ComboBoxItem Content="KPT - Kampot" />
                    <ComboBoxItem Content="KPS - Sihanoukville" />

                </ComboBox>

                <TextBox
                    x:Name="txtUsername"
                    Width="333"
                    Margin="0,0,0,10"
                    materialDesign:HintAssist.Hint="Username"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Account"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <PasswordBox
                    x:Name="txtPassword"
                    Width="333"
                    Margin="0,0,0,10"
                    materialDesign:HintAssist.Hint="Password"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Lock"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                <PasswordBox
                    x:Name="txtConfirmPassword"
                    Width="333"
                    Margin="0,0,0,18"
                    materialDesign:HintAssist.Hint="Confirm Password"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="LockCheck"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                <!--  Primary Button  -->

                <Button
                    x:Name="btnCreateStore"
                    Width="333"
                    Height="50"
                    Click="btnCreateStore_Click"
                    Content="CREATE STORE"
                    Style="{StaticResource PrimaryButton}" />

                <!--  Back  -->

                <Button
                    x:Name="btnBack"
                    Width="333"
                    Height="42"
                    Margin="0,10,0,0"
                    Click="btnBack_Click"
                    Content="BACK TO LOGIN"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />

            </StackPanel>

        </Grid>

    </materialDesign:Card>

</Window>
